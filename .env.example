STAGE=dev
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789
SHOPIFY_TOKEN_PARAMETER=/print-sync/dev/shopify-access-token
PRINTIFY_TOKEN_PARAMETER=/print-sync/dev/printify-token
PRINTFUL_TOKEN_PARAMETER=/print-sync/dev/printful-token
IMPORT_API_KEY_PARAMETER=/print-sync/dev/import-api-key
PRINTIFY_SHOP_ID=12345678
PRINTIFY_CURRENCY=USD
PRINTFUL_STORE_ID=
PRINTFUL_SELLING_REGION=worldwide
PRINTFUL_CURRENCY=USD
MARKUP_MULTIPLIER=1.5
MARKUP_FIXED_AMOUNT=5
IN_STOCK_QUANTITY=100
SECRET_CACHE_TTL_MS=300000
SYNC_PAGE_SIZE=100
